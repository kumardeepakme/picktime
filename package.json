{
  "name": "picktime",
  "version": "3.0.0",
  "description": "Accessible, form-associated time picker web component. Native form participation, Intl-driven i18n, zero-config styling.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/index.js",
    "**/index.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "chrome >= 114",
    "edge >= 114",
    "firefox >= 125",
    "safari >= 17"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run check:package",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumardeepakme/picktime.git"
  },
  "keywords": [
    "picktime",
    "timepicker",
    "time picker",
    "time",
    "picker",
    "web-component",
    "custom-element",
    "form-associated",
    "accessible",
    "a11y",
    "typescript"
  ],
  "author": "Kumar Deepak <inbox@kumardeepak.me> (https://kumardeepak.me)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kumardeepakme/picktime/issues"
  },
  "homepage": "https://github.com/kumardeepakme/picktime#readme",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "browserslist": "^4.28.8",
    "lightningcss": "^1.33.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
